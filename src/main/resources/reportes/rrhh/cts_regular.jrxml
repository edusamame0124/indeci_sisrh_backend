				<text><![CDATA[LIQUIDACIÓN DE DEPÓSITO SEMESTRAL DE CTS]]></text>
			</element>
			<element kind="textField" uuid="fc5a74fd-7a93-4d87-a784-71124877726d" x="0" y="70" width="555" height="60" fontSize="10.0" textAdjust="StretchHeight" hTextAlign="Justified">
				<expression><![CDATA[$P{EMPRESA_NOMBRE} + " con RUC Nº " + $P{EMPRESA_RUC} + ", domiciliado en " + $P{EMPRESA_DOMICILIO} + ", representado por Jefe de la Unidad de Recursos Humanos el Sr. " + $P{REPRESENTANTE} + ", en aplicación del artículo 248 del TUO del D.Leg. Nº 650, Ley de Compensación por Tiempo de Servicios aprobado mediante el D.S. Nº 001-97-TR, otorga a " + $P{EMPLEADO_NOMBRE} + " la presente constancia del depósito de su Compensación por Tiempo de Servicios realizado el " + $P{FECHA_DEPOSITO} + ", en la cuenta CTS Nº " + $P{NUMERO_CUENTA} + " en la institución financiera " + $P{ENTIDAD_BANCARIA} + " por los siguientes montos y periodos:"]]></expression>
			</element>
