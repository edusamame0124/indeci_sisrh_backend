<?xml version="1.0" encoding="UTF-8"?>
<!-- Papeleta de Permiso (INDECI) — formato institucional (mismo lenguaje visual que
     papeleta_vacaciones.jrxml / papeleta_teletrabajo.jrxml). Cubre los 7 motivos de permiso
     (códigos 001-007): un único checkbox queda marcado según el tipo de solicitud, con
     líneas opcionales para Lugar (Comisión de Servicio) y Descripción (Otros). Sin tabla de
     detalle repetible — un permiso es un solo día/rango horario, ajustado a UNA sola hoja A4. -->
